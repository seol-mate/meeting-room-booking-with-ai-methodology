# .nuriaim/session.yaml — 로컬 세션 설정 (커밋 금지 · .gitignore 대상)
#
# 이 작업 세션이 "어느 역할로" 수행 중인지를 담는다.
# 개발자·체크아웃마다 다른 로컬 상태이므로 공유 config.yaml이 아니라 여기에 둔다.
#
# 사용법: 이 내용으로 .nuriaim/session.yaml을 만들고 role·actor를 채운다.
#   (.nuriaim/.gitignore가 session.yaml을 커밋에서 제외한다)
#
# get_project_config 호출 시 이 파일 내용을 session_yaml 파라미터로 넘기면,
# 서버가 이 역할이 맡은 활동과 받은 요청을 기준으로 안내한다.

role: ""      # 이 세션의 수행 역할 (PM|PL|BA|DA|AA|TA|QA|UA|DV)
              #   겸임이면 쉼표로 나열: "PM,PL,DV"
              #   1인이 전 역할을 겸임하면 전체를 적는다: "PM,PL,BA,DA,AA,TA,QA,UA,DV"
              #   YAML 시퀀스로도 적을 수 있다 — 플로 시퀀스 "[PL, QA]" 또는
              #   블록 시퀀스("role:" 다음 줄에 "  - PL" / "  - QA"). 문자열·시퀀스 중
              #   편한 표기를 쓰면 되고, 서버가 둘 다 같은 방식으로 파싱한다.
actor: ""     # 수행자 이름 (예: git user.name)
              #   산출물에 담당자가 개인 단위로 지정된 경우(4-DN-21-O1 프로그램 목록의
              #   `담당자` 열) 이 값과 대조해 「역할은 맞지만 다른 사람의 담당분」을 가려낸다.
              #   비워 두면 역할 대조만 이뤄진다.
